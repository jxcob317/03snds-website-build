{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "03snds-website-build",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
